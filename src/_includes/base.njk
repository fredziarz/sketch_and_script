{%- set t = home[lang] -%}
{%- set other = lang | otherLang -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle or t.metaTitle }}</title>
  <meta name="description" content="{{ pageDescription or t.metaDescription }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ lang }}" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ other }}" href="{{ site.url }}{{ altUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ altUrl if lang == 'en' else page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ pageTitle or t.metaTitle }}">
  <meta property="og:description" content="{{ pageDescription or t.metaDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or projectList[0].pl.images[0].src }}">
  <meta property="og:locale" content="{{ 'pl_PL' if lang == 'pl' else 'en_GB' }}">
  <link rel="icon" type="image/png" href="/images/fav-icon.png">
  <link rel="preload" href="/assets/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/manrope-latin-ext.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
  <script>if(navigator.userAgentData&&navigator.userAgentData.brands.some(function(b){return b.brand==='Chromium'}))document.documentElement.classList.add('refract')</script>
  {%- if site.cloudflareAnalyticsToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>
  {%- endif %}
</head>
<body class="{{ bodyClass }}">
  <svg aria-hidden="true" width="0" height="0" style="position:absolute">
    <filter id="glass-bar" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feImage href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAABACAIAAACyWkFTAAAAQ0lEQVR4nO3HIQ2AAAAAwY/+Y0OgcEg0ngIkoAEVyID7EQHB78zjK/7554szGBwNTgZng4vB1eBmcDd4GDwNXgZv8wCDhYgs3hRzEgAAAABJRU5ErkJggg==" x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="map"/>
      <feDisplacementMap in="SourceGraphic" in2="map" scale="42" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
  </svg>
  <a href="#main" class="skip">{{ t.ui.skip }}</a>
  <header class="header" id="header">
    <a class="brand" href="{{ lang | homeUrl }}"><img src="/images/fav-icon.png" alt="" width="44" height="44"><span><small>Sketch and Script</small><span class="brand-name">{{ site.name }}</span><small>{{ t.tagline }}</small></span></a>
    <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="{{ t.ui.menu }}"><span></span><span></span><span></span></button>
    <nav class="menu" id="menu" aria-label="{{ t.ui.menu }}">
      {%- for item in t.nav %}
      <a href="{{ lang | homeUrl }}#{{ item.id }}">{{ item.label }}</a>
      {%- endfor %}
      {%- if site.codingVisible %}
      <a href="/code/">Code</a>
      {%- endif %}
      <a class="lang" href="{{ altUrl }}" hreflang="{{ other }}" lang="{{ other }}" title="{{ t.ui.langSwitch }}">{{ other | upper }}</a>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <span class="footer-id"><img src="/images/fav-icon.png" alt="" width="28" height="28"><span>© {{ year }} {{ site.company }} · {{ site.address }} · NIP {{ site.nip }}</span></span>
    <span class="footer-social">
      {%- if site.linkedin %}<a href="{{ site.linkedin }}" rel="noopener" target="_blank">LinkedIn</a>{% endif %}
      {%- if site.instagram %}{% if site.linkedin %} · {% endif %}<a href="{{ site.instagram }}" rel="noopener" target="_blank">Instagram</a>{% endif %}
    </span>
  </footer>
  <script src="/assets/js/site.js" defer></script>
  {%- if bodyClass == 'project' %}
  <script src="/assets/js/lightbox.js" defer></script>
  {%- endif %}
</body>
</html>
