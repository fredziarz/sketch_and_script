---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ lang | homeUrl }}"
layout: base.njk
bodyClass: home
eleventyComputed:
  altUrl: "{{ lang | otherLang | homeUrl }}"
---
{%- set t = home[lang] -%}
<section class="slides" aria-roledescription="carousel" aria-label="{{ t.portfolio.heading }}">
  {%- set frames = projectList | slideshow(lang) %}
  {%- for f in frames %}
  <figure class="slide{% if loop.first %} on{% endif %}" aria-roledescription="slide" aria-label="{{ t.ui.slide }} {{ loop.index }} / {{ loop.length }}">
    <img src="{{ f.img.src }}" alt="{{ f.img.alt }}" {% if loop.first %}loading="eager" fetchpriority="high"{% endif %}>
    <figcaption>
      <a href="{{ f.slug | projectUrl(lang) }}"><span class="slide-title">{{ f.title }}</span><span>{{ f.location }} · {{ t.ui.seeProject }} →</span></a>
    </figcaption>
  </figure>
  {%- endfor %}
  <button class="slides-pause" type="button" aria-pressed="false" aria-label="{{ t.ui.pause }}">❚❚</button>
</section>

<section class="section wrap intro">
  <h1>{{ t.intro.heading }}</h1>
  <p class="muted">{{ t.intro.text }}</p>
  <a class="btn" href="#{{ t.nav[5].id }}">{{ t.intro.cta }}</a>
</section>

<section class="section wrap" id="{{ t.nav[0].id }}">
  <p class="label">{{ t.portfolio.label }}</p>
  <h2>{{ t.portfolio.heading }}</h2>
  <div class="cards">
    {%- for p in projectList %}
    {%- set pr = p[lang] %}
    <a class="card" href="{{ p.slug | projectUrl(lang) }}">
      <div class="ph"><img src="{{ pr.images[0].src }}" alt="{{ pr.images[0].alt }}" sizes="(min-width: 800px) 50vw, 100vw"></div>
      <h3>{{ pr.title }}</h3>
      <p class="muted">{{ pr.location }}{% if pr.year %}, {{ pr.year }}{% endif %}</p>
    </a>
    {%- endfor %}
  </div>
</section>

<section class="section wrap rule" id="{{ t.nav[1].id }}">
  <p class="label">{{ t.process.label }}</p>
  <h2>{{ t.process.heading }}</h2>
  <div class="process">
  <p class="muted lead">{{ t.process.text }}</p>
  <ol class="steps">
    {%- for s in t.process.steps %}
    <li>
      <h3>{{ s.title }}</h3>
      <p>{{ s.text }}</p>
      {%- if s.deliverables %}<p class="muted"><strong>{{ t.process.deliverablesLabel }}</strong> {{ s.deliverables }}</p>{% endif %}
      {%- if s.duration %}<p class="duration">{{ s.duration }}</p>{% endif %}
    </li>
    {%- endfor %}
    <li class="extra">
      <h3>{{ t.process.extra.title }}</h3>
      <p>{{ t.process.extra.text }}</p>
    </li>
  </ol>
  </div>
</section>

<section class="section wrap rule" id="{{ t.nav[2].id }}">
  <p class="label">{{ t.services.label }}</p>
  <h2>{{ t.services.heading }}</h2>
  <ul class="services">
    {%- for s in t.services.items %}
    <li><h3>{{ s.title }}</h3><p class="muted">{{ s.text }}</p></li>
    {%- endfor %}
  </ul>
  <p class="lead">{{ t.services.area }}</p>
</section>

<section class="section wrap rule" id="{{ t.nav[3].id }}">
  <p class="label">{{ t.packages.label }}</p>
  <h2>{{ t.packages.heading }}</h2>
  <div class="scope-scroll">
    <table class="scope">
      <thead>
        <tr>
          <th scope="col">{{ t.packages.concept }}</th>
          <th scope="col">{{ t.packages.full }}</th>
          <th scope="col">{{ t.packages.premium }}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <ul>
              {%- for row in t.packages.rows %}{% if row.concept %}
              <li>{{ row.label }}</li>
              {% endif %}{% endfor %}
            </ul>
          </td>
          <td>
            <p>{{ t.packages.includesConcept }}</p>
            <ul>
              {%- for row in t.packages.rows %}{% if row.full and not row.concept %}
              <li>{{ row.label }}</li>
              {% endif %}{% endfor %}
            </ul>
          </td>
          <td>
            <p>{{ t.packages.includesFull }}</p>
            <ul>
              {%- for row in t.packages.rows %}{% if row.premium and not row.full %}
              <li>{{ row.label }}</li>
              {% endif %}{% endfor %}
            </ul>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<section class="section wrap rule" id="{{ t.nav[4].id }}">
  <div class="about">
    <div class="portrait">
      {%- if t.about.portrait %}<img src="{{ t.about.portrait }}" alt="{{ t.about.portraitAlt }}" sizes="280px">{% endif %}
    </div>
    <div>
      <p class="label">{{ t.about.label }}</p>
      <h2>{{ t.about.heading }}</h2>
      {{ t.about.text | paragraphs | safe }}
    </div>
  </div>
</section>

<section class="section wrap rule" id="{{ t.nav[5].id }}">
  <div class="contact">
    <div>
      <p class="label">{{ t.contact.label }}</p>
      <h2>{{ t.contact.heading }}</h2>
      <p class="muted">{{ t.contact.text }}</p>
      <dl class="contact-details">
        <dt>{{ t.contact.emailLabel }}</dt><dd><a href="mailto:{{ site.email }}">{{ site.email }}</a></dd>
        {%- if site.phone %}<dt>{{ t.contact.phoneLabel }}</dt><dd><a href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a></dd>{% endif %}
        <dt>{{ t.contact.locationLabel }}</dt><dd><a href="{{ site.mapUrl }}" rel="noopener" target="_blank">{{ site.location }}</a></dd>
      </dl>
    </div>
    {%- set f = t.contact.form %}
    <form class="contact-form" id="contact-form" data-sending="{{ f.sending }}" data-success="{{ f.success }}" data-error="{{ f.error }}">
      <input type="hidden" name="access_key" value="{{ site.web3formsKey }}">
      <input type="hidden" name="subject" value="{{ f.subject }}">
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off">
      <label>{{ f.name }} *<input type="text" name="name" autocomplete="name" required></label>
      <label>{{ f.email }} *<input type="email" name="email" autocomplete="email" required></label>
      <label>{{ f.service }}
        <select name="service">
          <option value="">{{ f.servicePlaceholder }}</option>
          {%- for s in f.services %}<option>{{ s }}</option>{% endfor %}
        </select>
      </label>
      <label>{{ f.message }} *<textarea name="message" rows="5" required></textarea></label>
      <button class="btn" type="submit">{{ f.submit }}</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
